# ---------------------------------------------------------------------------
# LedgerPulse - environment configuration
# Copy to `.env` (`cp .env.example .env`) then `make dev`.
# The demo runs fully with the deterministic MOCK providers (no paid keys).
# Set LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY to enable live Claude.
# ---------------------------------------------------------------------------

# --- Core ---
APP_ENV=local
API_PORT=8000
WEB_PORT=3000
# Dev-only signing secret for seeded JWT persona sessions. Not a real secret.
AUTH_SECRET=dev-only-change-me-ledgerpulse

# --- Postgres (pgvector) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ledgerpulse
POSTGRES_USER=ledgerpulse
POSTGRES_PASSWORD=ledgerpulse
# Async URL used by SQLAlchemy 2 (asyncpg). Alembic uses the sync variant.
DATABASE_URL=postgresql+asyncpg://ledgerpulse:ledgerpulse@postgres:5432/ledgerpulse
DATABASE_URL_SYNC=postgresql+psycopg://ledgerpulse:ledgerpulse@postgres:5432/ledgerpulse

# --- Redis (Celery broker/result + cache) ---
REDIS_URL=redis://redis:6379/0

# --- Object storage (MinIO, S3-compatible) ---
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=ledgerpulse
S3_SECRET_KEY=ledgerpulse-secret
S3_BUCKET=ledgerpulse-invoices

# --- Simulated AP mailbox (Mailpit) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
AP_INBOX_ADDRESS=invoices@ledgerpulse.local

# --- Mock ERP / accounting system of record ---
MOCK_ERP_URL=http://mock-erp:4010

# --- AI providers -----------------------------------------------------------
# Real Claude is the DEFAULT experience. Set ANTHROPIC_API_KEY below and the app runs
# live extraction / resolution / coding / investigation / copilot against Claude.
# If the key is empty, the gateway automatically falls back to the deterministic MOCK
# provider so the repo still boots (and CI/golden evals always pin mock for determinism).
# LLM_PROVIDER: anthropic | mock
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Model routing (overridable). See services/llm/config.py for defaults.
LLM_MODEL_CLASSIFY=claude-haiku-4-5-20251001
LLM_MODEL_EXTRACT=claude-sonnet-5
LLM_MODEL_EXTRACT_ESCALATE=claude-opus-4-8
LLM_MODEL_CODING=claude-sonnet-5
LLM_MODEL_INVESTIGATOR=claude-opus-4-8
LLM_MODEL_COPILOT=claude-sonnet-5

# Extraction reads the ACTUAL invoice image/PDF via Claude multimodal vision - no separate
# OCR service is required. OCR_PROVIDER stays for an optional Azure/Textract text layer.
# OCR_PROVIDER: none | azure | textract
OCR_PROVIDER=none

# Vendor/property resolution is Claude-based (the model reasons over candidate master data);
# no embeddings/pgvector are used, so no embeddings vendor or key is required.

# --- Provider call guardrails ---
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_DAILY_TOKEN_BUDGET=2000000
